admin_allowed_cidrs = [
  "203.0.113.10/32",
  "198.51.100.0/24",
]
ssh_public_key     = "ssh-ed25519 AAAA... user@example"

# The repository must be reachable from the VM without interactive credentials.
application_repository = "https://github.com/usamahahussain/personal-finance-tracker.git"
application_ref        = "<full-40-character-commit-containing-the-docker-deployment>"
application_dir        = "/opt/personal-finance-tracker"

# Set these through TF_VAR_backend_env and TF_VAR_adb_wallet_zip_base64, or in
# an ignored local tfvars file. Both values are stored in Terraform state.
# backend_env = {
#   LUNCHFLOW_URL              = "https://www.lunchflow.app/api/v1/accounts"
#   LUNCHFLOW_API_KEY          = "replace-with-lunchflow-api-key"
#   PFT_DB_USERNAME            = "finance_app"
#   PFT_DB_PASSWORD            = "replace-with-database-password"
#   PFT_DB_DSN                 = "pftdev_high"
#   PFT_DB_WALLET_PASSWORD     = "replace-with-wallet-password-if-required"
# }
# adb_wallet_zip_base64 = "$(base64 < Wallet_PFTDEV.zip | tr -d '\n')"

vcn_cidr                       = "10.0.0.0/16"
compartment_ocid               = "<compartment-ocid>"
existing_vcn_id                = "<existing-vcn-ocid>"
existing_public_route_table_id = "<existing-public-route-table-ocid>"
app_subnet_cidr                = "10.0.10.0/24"
db_subnet_cidr                 = "10.0.20.0/24"

compute_image_id = "ocid1.image.oc1.uk-london-1.aaaaaaaaiorlxd2y6vezrzh2j35scghnwa5lkrp7xeblrm6bo2xlqqsh4oha"

# Prefer setting this as TF_VAR_adb_admin_password instead of writing it to disk.
adb_admin_password = "replace-with-a-strong-password"
