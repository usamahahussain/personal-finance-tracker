# Copy to backend.hcl and replace the namespace placeholder.
# Fresh state: terraform init -backend-config=backend.hcl
# Existing local state: terraform init -migrate-state -backend-config=backend.hcl

bucket              = "pft-terraform-state"
namespace           = "<object-storage-namespace>"
key                 = "dev/terraform.tfstate"
region              = "uk-london-1"
auth                = "APIKey"
config_file_profile = "oracle"
